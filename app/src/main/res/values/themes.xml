<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.SKBank" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/deep_navy</item>
        <item name="colorPrimaryVariant">@color/royal_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bank_gold</item>
        <item name="colorSecondaryVariant">@color/light_gold</item>
        <item name="colorOnSecondary">@color/deep_navy</item>
        <item name="android:statusBarColor">@color/deep_navy</item>
    </style>

    <!-- SplashScreen Theme using androidx.core:core-splashscreen API -->
    <style name="Theme.SKBank.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sk_bank_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SKBank</item>
    </style>
</resources>
