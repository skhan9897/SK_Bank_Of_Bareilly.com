<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#E0AA3E" /> <!-- Gold base -->
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#40000000" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <size android:height="1dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <size android:width="1dp" />
        </shape>
    </item>
</layer-list>