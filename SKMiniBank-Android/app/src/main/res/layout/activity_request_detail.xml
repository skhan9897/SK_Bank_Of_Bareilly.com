<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@color/card_background">

                    <TextView
                        android:id="@+id/tvDetailReqType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cheque Book Request"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark_primary"/>

                    <TextView
                        android:id="@+id/tvDetailReqStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENDING"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/white"
                        android:background="@drawable/badge_pending"
                        android:layout_marginTop="12dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_light"
                        android:layout_marginVertical="24dp"/>

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1">

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="Request ID" android:textColor="@color/text_dark_secondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvDetailReqId" android:text="#000" android:textColor="@color/text_dark_primary" android:textSize="14sp" android:gravity="end" android:textStyle="bold"/>
                        </TableRow>

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="Request Date" android:textColor="@color/text_dark_secondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvDetailReqDate" android:text="---" android:textColor="@color/text_dark_primary" android:textSize="14sp" android:gravity="end" android:textStyle="bold"/>
                        </TableRow>

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="Account Number" android:textColor="@color/text_dark_secondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvDetailReqAcc" android:text="---" android:textColor="@color/text_dark_primary" android:textSize="14sp" android:gravity="end" android:textStyle="bold"/>
                        </TableRow>

                        <TableRow android:id="@+id/rowApprovalDate" android:paddingVertical="8dp" android:visibility="gone">
                            <TextView android:text="Approval Date" android:textColor="@color/text_dark_secondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvDetailApprDate" android:text="---" android:textColor="@color/text_dark_primary" android:textSize="14sp" android:gravity="end" android:textStyle="bold"/>
                        </TableRow>

                        <TableRow android:id="@+id/rowExpectedDate" android:paddingVertical="8dp" android:visibility="gone">
                            <TextView android:text="Expected Delivery" android:textColor="@color/text_dark_secondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvDetailExpDate" android:text="---" android:textColor="@color/text_dark_primary" android:textSize="14sp" android:gravity="end" android:textStyle="bold"/>
                        </TableRow>

                    </TableLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin Remarks"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"/>

                    <TextView
                        android:id="@+id/tvDetailRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No remarks yet."
                        android:textColor="@color/text_dark_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        android:background="@color/light_background"
                        android:padding="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>