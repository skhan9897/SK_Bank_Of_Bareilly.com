<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_bg"
    android:gravity="center_horizontal">

    <RelativeLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/accent_green"
            android:background="@drawable/white_circle_bg"
            android:padding="16dp"
            android:contentDescription="Success Icon"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/accent_green"
            android:background="@drawable/white_circle_bg"
            android:padding="2dp"
            android:contentDescription="Checkmark"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Balance check successful"
        android:textColor="@color/text_dark_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/white_circle_bg"
        android:backgroundTint="#10000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBankLogoResult"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/sk_logo" />

        <TextView
            android:id="@+id/tvBankDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="SK Mini Payment Bank"
            android:textColor="@color/text_dark_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Available Balance"
        android:textColor="@color/text_dark_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvBalanceResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="₹ 0.00"
        android:textColor="@color/text_dark_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="BRAND IN FOCUS"
        android:textColor="@color/text_dark_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Placeholders for "Brand in focus" icons -->
        <include layout="@layout/item_pp_service" android:id="@+id/brand1" />
        <include layout="@layout/item_pp_service" android:id="@+id/brand2" />
        <include layout="@layout/item_pp_service" android:id="@+id/brand3" />
        <include layout="@layout/item_pp_service" android:id="@+id/brand4" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="DONE"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="12dp" />

</LinearLayout>