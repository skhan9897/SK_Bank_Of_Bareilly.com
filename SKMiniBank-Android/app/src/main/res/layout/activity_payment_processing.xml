<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <ProgressBar
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary_blue"
                android:indeterminateTintMode="src_in" />

            <ImageView
                android:id="@+id/ivProcessingLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="Loading logo"
                android:padding="8dp"
                android:src="@drawable/sk_logo" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Processing Payment..."
            android:textColor="@color/text_dark_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Do not press back or close the app"
            android:textColor="@color/text_dark_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvProcessingAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="₹ 0.00"
            android:textColor="@color/premium_gold"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="@color/text_dark_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="100% SECURE TRANSACTIONS"
            android:textColor="@color/text_dark_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>

</RelativeLayout>