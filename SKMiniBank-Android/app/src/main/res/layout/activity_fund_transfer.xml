<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_gradient">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#40000000"
        app:title="Internal Fund Transfer"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSFER DETAILS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:alpha="0.8"
                android:letterSpacing="0.1"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/glass_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Payee Account Number"
                        android:textColorHint="#B3FFFFFF"
                        app:boxStrokeColor="@color/white"
                        app:hintTextColor="@color/web_accent_blue"
                        app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                        app:startIconTint="#B3FFFFFF">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etToAccount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Transfer Amount"
                        android:textColorHint="#B3FFFFFF"
                        app:prefixText="₹ "
                        app:prefixTextColor="@color/white"
                        app:boxStrokeColor="@color/white"
                        app:hintTextColor="@color/web_accent_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Remarks (Optional)"
                        android:textColorHint="#B3FFFFFF"
                        app:boxStrokeColor="@color/white"
                        app:hintTextColor="@color/web_accent_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="4-Digit Transaction PIN"
                        android:textColorHint="#B3FFFFFF"
                        app:boxStrokeColor="@color/white"
                        app:hintTextColor="@color/web_accent_blue"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#B3FFFFFF">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:inputType="numberPassword"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTransfer"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="32dp"
                        android:text="CONFIRM TRANSFER"
                        android:backgroundTint="@color/premium_gold"
                        android:textColor="@color/primary_blue"
                        android:textStyle="bold"
                        app:cornerRadius="15dp"
                        android:elevation="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe &amp; Secure 256-bit Encrypted Transaction"
                android:textSize="11sp"
                android:textColor="#80FFFFFF"
                android:layout_marginTop="24dp"
                android:layout_gravity="center"
                app:drawableStartCompat="@android:drawable/ic_lock_idle_lock"
                app:drawableTint="#80FFFFFF"
                android:drawablePadding="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>