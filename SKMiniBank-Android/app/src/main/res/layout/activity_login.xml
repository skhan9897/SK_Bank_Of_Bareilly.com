<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Logo Section -->
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_bank_logo"
                android:layout_marginBottom="16dp"
                android:contentDescription="SK Logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPAY"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAYMENT BANK"
                android:textColor="@color/premium_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.4"
                android:layout_marginBottom="32dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="@color/glass_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Login Form -->
                    <LinearLayout
                        android:id="@+id/layoutLoginForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WELCOME BACK"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="24dp"
                            android:layout_gravity="center"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilMobile"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Registered Mobile Number"
                            android:textColorHint="#80FFFFFF"
                            app:boxStrokeColor="@color/white"
                            app:hintTextColor="@color/web_accent_blue"
                            app:startIconDrawable="@android:drawable/ic_menu_call"
                            app:startIconTint="#80FFFFFF"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMobileNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:inputType="phone"
                                android:maxLength="10" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilOtp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter 4-Digit OTP"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"
                            android:textColorHint="#80FFFFFF"
                            app:boxStrokeColor="@color/white"
                            app:hintTextColor="@color/web_accent_blue"
                            app:startIconDrawable="@android:drawable/ic_dialog_info"
                            app:startIconTint="#80FFFFFF"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOtp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:inputType="number"
                                android:maxLength="4" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Customer Password"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"
                            android:textColorHint="#80FFFFFF"
                            app:boxStrokeColor="@color/white"
                            app:hintTextColor="@color/web_accent_blue"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#80FFFFFF"
                            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                            app:startIconTint="#80FFFFFF"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:text="PROCEED"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="@color/web_accent_blue"
                            android:elevation="4dp" />

                        <!-- Biometric Login -->
                        <LinearLayout
                            android:id="@+id/btnBiometricLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@android:drawable/ic_lock_idle_lock"
                                app:tint="@color/premium_gold" />
                            <TextView
                                android:id="@+id/tvBiometricLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Login with Fingerprint"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="20dp"
                            android:text="Forgot Password?"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Landing (New User) -->
                    <LinearLayout
                        android:id="@+id/layoutLanding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLandingOpenAccount"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="OPEN NEW ACCOUNT"
                            app:cornerRadius="12dp"
                            android:backgroundTint="@color/premium_gold"
                            android:textColor="@color/primary_blue"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShowLogin"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="ALREADY A CUSTOMER? LOGIN"
                            android:textColor="@color/white" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/btnOpenAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Don't have an account? JOIN NOW"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="© 2026 SPAY PAYMENT BANK | SECURE"
                android:textColor="#4DFFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.1"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>