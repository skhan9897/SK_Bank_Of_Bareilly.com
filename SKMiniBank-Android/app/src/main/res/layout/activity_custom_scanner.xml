<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="true" />

    <!-- Top Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#99000000"
        android:layout_alignParentTop="true"/>

    <!-- Bottom Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="500dp"
        android:background="#99000000" />

    <!-- Left Overlay -->
    <View
        android:layout_width="40dp"
        android:layout_height="400dp"
        android:layout_marginTop="100dp"
        android:background="#99000000"
        android:layout_alignParentStart="true"/>

    <!-- Right Overlay -->
    <View
        android:layout_width="40dp"
        android:layout_height="400dp"
        android:layout_marginTop="100dp"
        android:background="#99000000"
        android:layout_alignParentEnd="true"/>

    <!-- Viewfinder Frame -->
    <View
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="100dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/scanner_frame"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:text="Align QR Code inside the frame"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="32dp">

        <LinearLayout
            android:id="@+id/btnGalleryScanner"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/white_circle_bg"
                android:backgroundTint="#25FFFFFF"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Upload QR"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnFlashlight"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp">

            <ImageView
                android:id="@+id/ivFlashIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/white_circle_bg"
                android:backgroundTint="#25FFFFFF"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Flashlight"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/btnBackScanner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/white_circle_bg"
        android:backgroundTint="#80000000"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/white" />

</RelativeLayout>
