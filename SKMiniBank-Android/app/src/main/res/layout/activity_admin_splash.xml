<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/admin_bg_gradient">

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo/Title Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logoBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="30dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp"
                android:paddingVertical="40dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SK ADMIN"
                    android:textColor="@color/white"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:shadowColor="#80000000"
                    android:shadowRadius="10"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Centralized Management"
                    android:textColor="#00d2ff"
                    android:textSize="14sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.4"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Section -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/splashProgress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="0"
                android:max="100"
                android:progressBackgroundTint="#1AFFFFFF"
                android:progressTint="#00d2ff" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Initializing Secure Terminal..."
                android:textColor="#8892b0"
                android:textSize="13sp"
                android:letterSpacing="0.1"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:text="DEVELOPED BY SAJID KHAN"
        android:textColor="#4DFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:textAllCaps="true"/>

</RelativeLayout>
